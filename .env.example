# 로컬 실행용 예시. 복사해서 .env 로 쓴다(.env 는 커밋하지 않는다).
# 값은 compose.yaml 의 개발용 더미 계정이며 실제 비밀값이 아니다.

# PostgreSQL 접속 문자열(libpq 형식). 앱은 PgBouncer(transaction 모드)로만 붙는다. 필수.
DATABASE_URL=postgresql://demo:demo@127.0.0.1:56432/demo
# 화면·응답에 보이는 환경 이름(aws-tokyo, gcp-seoul, onprem-…). 없으면 unknown.
ECHO_ENVIRONMENT=local
# 표시용 버전(커밋 등). 없으면 dev.
APP_VERSION=dev
# 시작 때 sql/schema.sql 로 스키마를 맞춘다.
AUTO_MIGRATE=true
IDEMPOTENT_WRITES=false
# 듣는 포트.
PORT=8080

# 통합 시험이 붙는 DB(PgBouncer 경유). 시험이 장부를 비우므로 시연 DB 를 넣지 않는다.
TEST_DATABASE_URL=postgresql://demo:demo@127.0.0.1:56432/demo
# 1 이면 TEST_DATABASE_URL 이 없거나 닿지 않을 때 통합 시험을 건너뛰지 않고 실패시킨다(CI).
REQUIRE_DB_TESTS=0
